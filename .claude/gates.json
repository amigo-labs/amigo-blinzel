{
  "$comment": "Quality gates for the hooks in .claude/hooks/ and the /qa, /spec-build, /spec-check skills. `full` mirrors the Linux job of .github/workflows/ci.yml (the Windows and macOS jobs run in CI only, AGENTS.md §10); `fast` runs in the Stop hook, filtered by `paths` (prefixes of changed repository paths). `needs` lists the ids a gate waits for; gates without needs between them run in parallel.",
  "fast": [
    {
      "id": "rust-fmt",
      "name": "rustfmt",
      "cwd": ".",
      "command": "cargo fmt --all --check",
      "fix": "cargo fmt --all",
      "paths": ["crates/", "Cargo.toml"],
      "needs": []
    },
    {
      "id": "rust-clippy",
      "name": "clippy",
      "cwd": ".",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "paths": ["crates/", "i18n/", "third_party/", "Cargo.toml", "Cargo.lock", ".cargo/"],
      "needs": []
    }
  ],
  "full": [
    {
      "id": "rust-fmt",
      "name": "rustfmt",
      "cwd": ".",
      "command": "cargo fmt --all --check",
      "fix": "cargo fmt --all",
      "needs": []
    },
    {
      "id": "rust-clippy",
      "name": "clippy",
      "cwd": ".",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "needs": []
    },
    {
      "id": "rust-test",
      "name": "cargo test",
      "cwd": ".",
      "command": "cargo test --workspace",
      "needs": ["rust-clippy"]
    },
    {
      "id": "notices",
      "name": "third-party notices current",
      "cwd": ".",
      "command": "cargo run --locked -p blinzel-release -- notices --check",
      "fix": "cargo run -p blinzel-release -- notices",
      "needs": ["rust-clippy"]
    }
  ],
  "suppressions": [
    "#[allow(",
    "#![allow(",
    "#[expect(",
    "#![expect(",
    "#[ignore"
  ]
}
